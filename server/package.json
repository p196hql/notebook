{
  "name": "notebook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "rag:install": "python3 -m venv .venv && ./.venv/bin/python -m pip install -r requirements.txt",
    "rag:dev": "./.venv/bin/python rag/app.py",
    "rag:start": "./.venv/bin/python rag/app.py",
    "rag:wipe": "node scripts/wipe-rag-storage.js",
    "dev:all": "concurrently -k -n rag,api -c blue,green \"npm run rag:dev\" \"npm run dev\"",
    "notebooks:wipe": "node scripts/wipe-notebook-data.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.6.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.5",
    "multer": "^1.4.5-lts.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  }
}
